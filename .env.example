# Mac Health Checkup environment contract
# Copy to `.env` for local shell usage, then export variables as needed.
# Empty values are treated as invalid for strict fail-fast startup validation.

# Optional: alternate config file path.
# Example: /Users/you/dev/Mac_Health_Checkup/config/config.json
# MAC_HEALTH_CHECKUP_CONFIG=

# Optional: max config file size in bytes (1..10000000).
# Example: 1048576
# MAC_HEALTH_CHECKUP_CONFIG_MAX_BYTES=1048576

# Optional: runtime override for api.bind_host.
# Example: 127.0.0.1
# MAC_HEALTH_CHECKUP_API_BIND_HOST=

# Optional: runtime override for api.port (0..65535, where 0 picks an ephemeral port).
# Example: 7878
# MAC_HEALTH_CHECKUP_API_PORT=

# Optional: runtime override for api.auth_token.
# Recommended for real secrets so `config/config.json` can stay safe to commit.
# Example: replace-with-a-32-plus-character-random-token
# MAC_HEALTH_CHECKUP_API_AUTH_TOKEN=

# Optional: public URL printed for pairing when serving.
# Must be scheme://host[:port] with no path/query/fragment.
# Example: https://example.test:7878
# MAC_HEALTH_CHECKUP_PUBLIC_BASE_URL=
